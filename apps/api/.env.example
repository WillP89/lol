# Copy to .env for local development. Never commit a real .env.
DATABASE_URL="postgresql://plot:plot_dev_local@localhost:5432/plot_dev"
PORT=4000
NODE_ENV=development
SESSION_SECRET="replace-with-a-real-32-byte-random-secret"
TOKEN_HASH_SECRET="replace-with-a-real-32-byte-random-secret"
WEB_APP_URL="http://localhost:3000"

# --- Real transactional email — plotmaker.co.uk is verified in Resend. Set these on Render
# (API service → Environment) to send real magic-link emails to anyone, not just a dev-mode
# link. See docs/providers/email.md.
RESEND_API_KEY=
EMAIL_FROM="hello@plotmaker.co.uk"

# --- Not required for the pilot foundation; documented for when they're available ---
# See docs/providers/oauth.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=
# See docs/providers/payments.md
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# See docs/providers/ticketing.md, docs/providers/restaurants.md
TICKETMASTER_API_KEY=
SKIDDLE_API_KEY=
DICE_API_KEY=
EVENTBRITE_API_KEY=
OPENTABLE_API_KEY=
# A genuinely different-shaped source from the two above — a broad events-intelligence aggregator
# (community, festivals, food & drink, performing arts, sport), not another ticketed-listings
# site. See providers/live/predicthq.ts's own header for two things to verify (current self-serve
# pricing, and the lack of a public click-through URL) before applying. Self-serve: predicthq.com.
PREDICTHQ_ACCESS_TOKEN=
# Real, category-appropriate photo fallback for any event with no artist/venue-specific photo —
# see lib/pexelsStockImages.ts and docs/DECISIONS.md#category-stock-images for the full reasoning
# (short version: Wikimedia blocks this app's real production traffic with a 403, so its own
# Commons search alone can't be trusted to cover this; Pexels is the reliable source). Free key,
# no billing: pexels.com/api -> sign up -> API key, ~2 minutes.
PEXELS_API_KEY=
